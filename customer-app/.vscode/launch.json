        },
        {
            "name": "zenfoo-customer (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "zenfoo-customer (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "zenfoo-customer (release mode - no verbose)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": []
        },
        {
            "name": "Run Tests (Debug)",
            "request": "launch",
            "type": "dart",
            "program": "test",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Run Tests (Release)",
            "request": "launch",
            "type": "dart",
            "program": "test",
            "cwd": "${workspaceFolder}",
            "flutterMode": "release"
        },
        {
            "name": "Run Integration Tests (Release)",
            "request": "launch",
            "type": "dart",
            "program": "integration_test",
            "cwd": "${workspaceFolder}",
            "flutterMode": "release"
        }
    ]
