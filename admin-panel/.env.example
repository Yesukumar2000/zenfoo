APP_NAME=Zenfoo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

STRIPE_KEY=
STRIPE_SECRET=

# Read by config/services.php -> config('services.stripe.*')
STRIPE_API_PUBLIC=
STRIPE_API_SECRET=

# Firebase admin SDK: copy config/firebase.json.example to config/firebase.json
# and fill it with a real service account key. That file is gitignored.

# Fast2SMS Configuration
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=ZENFOO
FAST2SMS_MESSAGE_ID=205419
FAST2SMS_CUSTOMER_MESSAGE_ID=205205

# PhonePe Configuration (UAT Sandbox)
# Get your credentials from: https://developer.phonepe.com
# Test OTP: 123456
PHONEPE_MERCHANT_ID=PGTESTPAYUAT
PHONEPE_SALT_KEY=099eb0cd-02cf-4e2a-8aca-3e6c6aff0399
PHONEPE_SALT_INDEX=1
PHONEPE_IS_PRODUCTION=false
# Mock mode for payout API (set to true to simulate payouts without calling PhonePe API)
# Defaults to true when PHONEPE_IS_PRODUCTION=false
# Set to false to use actual sandbox API (if available)
PHONEPE_MOCK_MODE=true
